# 环境变量示例文件
# 复制此文件为 .env 并根据需要修改

# 环境设置: development, production, test
NODE_ENV=development

# 应用端口
PORT=5678

# 日志级别
LOG_LEVEL=dev

# 认证设置
AUTH_ENABLED=true
# 生产环境请使用强密码，生成命令: openssl rand -base64 32
AUTH_PASSWORD=

# API token for Coze plugin or other API clients
API_TOKEN=your_super_secret_and_long_token_here

# 会话密钥 - 生成命令: openssl rand -base64 32
SESSION_SECRET=

# 数据库路径（可选，默认为 ./db/html-go.db）
DB_PATH=

# 会话存储路径（可选，默认为 ./sessions）
SESSION_PATH=

# PM2配置（可选）
PM2_INSTANCES=max
PM2_MAX_MEMORY=1G

# 安全配置
# CORS origins (逗号分隔)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ===== CSP（内容安全策略）配置 =====
# 是否启用 CSP，默认为 true
# 私有部署且无外部威胁时可设为 false
# 公网部署务必保持为 true
ENABLE_CSP=true

# CSP 灰度模式：true 时仅报告违规不阻止，false 时严格阻止
CSP_REPORT_ONLY=false

# CSP 违规上报端点（留空则不上报）
CSP_REPORT_URI=/csp-report

# 额外的可信 CDN 域名（逗号分隔）
# 示例：EXTRA_CDN_ORIGINS=https://custom-cdn.example.com,https://another-cdn.com
EXTRA_CDN_ORIGINS=

# SSL配置（生产环境推荐）
SSL_ENABLED=false
SSL_KEY_PATH=
SSL_CERT_PATH=

# 日志配置
LOG_FILE_PATH=
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# 性能配置
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# 监控配置
ENABLE_METRICS=false
METRICS_PORT=9090

# 集群模式配置
# 工作进程数量（默认为CPU核心数）
CLUSTER_WORKERS=
# 重启延迟（毫秒）
CLUSTER_RESTART_DELAY=1000
# 最大重启次数
CLUSTER_MAX_RESTARTS=5
# 重启时间窗口（毫秒）
CLUSTER_RESTART_WINDOW=60000