<% 
// 设置页面数据
const currentPath = '/admin/apikeys';
const title = 'API Key管理';
const breadcrumb = [
    { title: '管理后台', url: '/admin/dashboard' },
    { title: 'API Key管理' }
];
%>

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - HTML-GO 管理后台</title>
    <!-- 设计系统与组件库样式（统一视觉与8px网格） -->
    <link rel="stylesheet" href="/css/design-system.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="icon" href="/icon/web/favicon.ico">
</head>
<body class="admin-body">
    <div class="admin-layout">
        <!-- 顶部导航栏 -->
        <nav class="top-nav">
            <div class="nav-left">
                <div class="nav-brand">
                    <span class="brand-icon">🚀</span>
                    <span class="brand-text">HTML-GO Admin</span>
                </div>
                <button class="sidebar-toggle" id="sidebarToggle">
                    <span class="toggle-icon">☰</span>
                </button>
            </div>
            <div class="nav-right">
                <div class="user-menu">
                    <span class="user-icon">👤</span>
                    <span class="user-name">管理员</span>
                </div>
            </div>
        </nav>

        <!-- 侧边导航栏 -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-content">
                <nav class="sidebar-nav">
                    <ul class="nav-list">
                        <li class="nav-item">
                            <a href="/admin/dashboard" class="nav-link">
                                <span class="nav-icon">📊</span>
                                <span class="nav-text">概览</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/admin/pages" class="nav-link">
                                <span class="nav-icon">📄</span>
                                <span class="nav-text">页面管理</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/admin/apikeys" class="nav-link active">
                                <span class="nav-icon">🔑</span>
                                <span class="nav-text">API Key管理</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/admin/settings" class="nav-link">
                                <span class="nav-icon">⚙️</span>
                                <span class="nav-text">系统设置</span>
                            </a>
                        </li>
                    </ul>
                </nav>
                
                <div class="sidebar-footer">
                    <a href="/" class="btn btn-sm btn-outline">🌐 前台</a>
                    <a href="/admin/pages/new" class="btn btn-sm btn-primary">➕ 新建</a>
                </div>
            </div>
        </aside>

        <!-- 主要内容区域 -->
        <main class="main-content">
            <!-- 面包屑导航 -->
            <div class="breadcrumb-container">
                <nav class="breadcrumb" aria-label="面包屑">
                    <a href="/admin/dashboard" class="breadcrumb-link">管理后台</a>
                    <span class="breadcrumb-separator" aria-hidden="true">/</span>
                    <span class="breadcrumb-current" aria-current="page">API Key管理</span>
                </nav>
            </div>

            <!-- 页面内容 -->
            <div class="page-content admin-page">
                <div class="admin-page-toolbar">
  <div class="toolbar-left">
    <h1 class="admin-page-title">API Key管理</h1>
    <p class="admin-page-subtitle">管理API密钥，快速筛选、创建与查看使用情况。</p>
  </div>
  <div class="toolbar-right" role="group" aria-label="API Key 操作">
    <div class="toolbar-search">
      <i class="fas fa-search search-icon" aria-hidden="true"></i>
      <input type="search" id="apiKeySearchInput" placeholder="搜索名称或描述" aria-label="搜索 API Key">
      <span class="clear-icon" id="apiKeySearchClear" title="清除搜索">
        <i class="fas fa-times-circle"></i>
      </span>
    </div>
    <div class="toolbar-chip-group" aria-label="状态筛选">
      <button type="button" class="toolbar-chip is-active" data-filter-status="all">全部</button>
      <button type="button" class="toolbar-chip" data-filter-status="active">活跃</button>
      <button type="button" class="toolbar-chip" data-filter-status="inactive">已禁用</button>
    </div>
    <div class="toolbar-chip-group" aria-label="权限筛选">
      <button type="button" class="toolbar-chip is-active" data-filter-permission="all">全部权限</button>
      <button type="button" class="toolbar-chip" data-filter-permission="read">仅读取</button>
      <button type="button" class="toolbar-chip" data-filter-permission="write">包含写入</button>
    </div>
    <button class="toolbar-icon-btn" id="btnRefreshKeys" title="刷新" aria-label="刷新列表">
      <i class="fas fa-rotate"></i>
    </button>
    <button class="toolbar-primary" id="btnOpenCreateKey">
      <i class="fas fa-plus"></i>
      创建新Key
    </button>
  </div>
</div>

<div class="stats-compact" role="status" aria-live="polite">
  <div class="stat-card">
    <div class="stat-info">
      <div class="stat-meta">
        <span class="stat-dot blue"></span>
        <span class="stat-label">总计 Key 数量</span>
      </div>
      <span class="stat-value" id="totalKeys">--</span>
    </div>
    <i class="fas fa-key" aria-hidden="true" style="color:#94a3b8"></i>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <div class="stat-meta">
        <span class="stat-dot green"></span>
        <span class="stat-label">活跃 Key 数量</span>
      </div>
      <span class="stat-value" id="activeKeys">--</span>
    </div>
    <i class="fas fa-sparkles" aria-hidden="true" style="color:#94a3b8"></i>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <div class="stat-meta">
        <span class="stat-dot orange"></span>
        <span class="stat-label">今日调用次数</span>
      </div>
      <span class="stat-value" id="todayCalls">--</span>
    </div>
    <i class="fas fa-chart-line" aria-hidden="true" style="color:#94a3b8"></i>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <div class="stat-meta">
        <span class="stat-dot purple"></span>
        <span class="stat-label">平均响应时间</span>
      </div>
      <span class="stat-value" id="avgResponseTime">--</span>
    </div>
    <i class="fas fa-clock" aria-hidden="true" style="color:#94a3b8"></i>
  </div>
</div>

<!-- API Key列表 -->
<div class="card-clean table-card">
  <div class="card-header">
    <h2 class="card-title">API Key 列表</h2>
  </div>
  <div class="card-body">
    <div id="loadingSpinner" class="skeleton-table">
      <div class="skeleton-line"></div>
      <div class="skeleton-line medium"></div>
      <div class="skeleton-line"></div>
      <div class="skeleton-line short"></div>
    </div>

    <div id="keyListContainer" style="display: none;">
      <div class="table-responsive">
        <table class="table-modern" role="table" aria-label="API Key 列表">
          <thead>
            <tr>
              <th scope="col">名称</th>
              <th scope="col">权限</th>
              <th scope="col">使用限制</th>
              <th scope="col">状态</th>
              <th scope="col">最后使用</th>
              <th scope="col">创建时间</th>
              <th scope="col" aria-label="操作">操作</th>
            </tr>
          </thead>
          <tbody id="keyListBody">
            <!-- 数据将通过JavaScript动态加载 -->
          </tbody>
        </table>
      </div>

      <div id="emptyState" class="empty-state-spot" style="display: none;">
        <div class="empty-icon">
          <i class="fas fa-key"></i>
        </div>
        <div class="empty-title">还没有 API Key</div>
        <div class="empty-desc">立即创建您的第一个 API Key，并安全地控管访问权限。</div>
        <button type="button" class="toolbar-primary" id="btnOpenCreateKeyEmpty" data-action="create">
          <i class="fas fa-plus"></i>
          创建新Key
        </button>
      </div>
    </div>
  </div>
</div>

<!-- 创建API Key模态框 -->
<div id="createModal" class="modal-backdrop-clean" role="dialog" aria-modal="true" aria-labelledby="createModalTitle" style="display: none;">
  <div class="modal-clean" role="document">
    <div class="modal-header">
      <div>
        <h3 class="modal-title" id="createModalTitle">创建新的 API Key</h3>
        <p class="modal-subtitle">配置访问权限与使用限制，确保安全可控。</p>
      </div>
      <button type="button" class="modal-close-btn" id="btnCloseCreateModal" aria-label="关闭">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="modal-body">
      <form id="createKeyForm">
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label-strong" for="keyName">名称 *</label>
            <input type="text" id="keyName" name="name" class="form-input" placeholder="例如：前端应用 API Key" required>
            <div class="form-feedback" id="keyNameFeedback"></div>
            <p class="helper-text">用于快速识别此 API Key 的用途</p>
          </div>
          <div class="form-group grid-span-2">
            <label class="form-label-strong" for="keyDescription">描述</label>
            <textarea id="keyDescription" name="description" class="form-input" rows="3" placeholder="描述这个 Key 的使用场景（可选）"></textarea>
            <p class="helper-text">例如：用于内部自动化任务，或第三方服务集成</p>
          </div>
          <div class="form-group grid-span-2">
            <label class="form-label-strong">权限设置</label>
            <div class="permission-toggle-row">
              <label class="permission-card toggle-card is-active">
                <div>
                  <h5>读取权限</h5>
                  <p>查看页面、获取列表</p>
                </div>
                <div class="toggle-switch is-on" aria-hidden="true"></div>
                <input type="checkbox" name="permissions" value="read" checked hidden>
              </label>
              <label class="permission-card toggle-card is-active">
                <div>
                  <h5>写入权限</h5>
                  <p>创建页面、修改内容</p>
                </div>
                <div class="toggle-switch is-on" aria-hidden="true"></div>
                <input type="checkbox" name="permissions" value="write" checked hidden>
              </label>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label-strong" for="maxHourly">每小时限制</label>
            <div class="input-suffix">
              <input type="number" id="maxHourly" name="maxRequestsPerHour" class="form-input" value="1000" min="1" max="10000">
              <span class="suffix">次/小时</span>
            </div>
            <div class="form-feedback" id="maxHourlyFeedback"></div>
          </div>
          <div class="form-group">
            <label class="form-label-strong" for="maxDaily">每日限制</label>
            <div class="input-suffix">
              <input type="number" id="maxDaily" name="maxRequestsPerDay" class="form-input" value="10000" min="1" max="100000">
              <span class="suffix">次/天</span>
            </div>
            <div class="form-feedback" id="maxDailyFeedback"></div>
          </div>
          <div class="form-group">
            <label class="form-label-strong" for="expiresAt">过期时间</label>
            <input type="datetime-local" id="expiresAt" name="expiresAt" class="form-input">
            <p class="helper-text">留空表示永不过期</p>
          </div>
        </div>
      </form>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn-secondary" id="btnCancelCreateModal">取消</button>
      <button type="button" class="btn-primary btn-loading-capable" id="createKeyBtn">
        <span class="btn-content">
          <i class="fas fa-key"></i>
          创建 API Key
        </span>
        <span class="btn-loading" style="display:none;">
          <i class="fas fa-spinner fa-spin"></i>
          创建中...
        </span>
      </button>
    </div>
  </div>
</div>
<!-- API Key详情模态框 -->
<div id="keyDetailModal" class="modal-backdrop-clean" role="dialog" aria-modal="true" aria-labelledby="keyDetailModalTitle" style="display: none;">
  <div class="modal-clean detail-modal" role="document">
    <div class="modal-header">
      <div class="modal-header-main">
        <h3 class="modal-title" id="keyDetailModalTitle">API Key 详情</h3>
        <p class="modal-subtitle">集中查看权限、配额与使用情况。</p>
      </div>
      <button type="button" class="modal-close-btn" id="btnCloseKeyDetail" aria-label="关闭">
        <i class="fas fa-times"></i>
      </button>
    </div>
    
    <div class="modal-body">
      <div id="keyDetailContent"></div>
    </div>
    
    <div class="modal-footer detail-footer">
      <button type="button" class="btn-secondary" id="btnCloseKeyDetail2">关闭</button>
    </div>
  </div>
</div>

<!-- API Key成功创建模态框 -->
<div id="keySuccessModal" class="modal-backdrop-clean" role="dialog" aria-modal="true" aria-labelledby="keySuccessModalTitle" style="display: none;">
  <div class="modal-clean" role="document">
    <div class="modal-header">
      <div class="modal-header-main">
        <div class="success-spot">
          <i class="fas fa-check"></i>
        </div>
        <div>
          <h3 class="modal-title" id="keySuccessModalTitle">API Key 创建成功</h3>
          <p class="modal-subtitle">请立即复制并妥善保管，我们只会显示一次密钥。</p>
        </div>
      </div>
      <button type="button" class="modal-close-btn" id="btnCloseSuccessModal" aria-label="关闭">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="modal-body">
      <div class="success-card">
        <div class="readonly-key">
          <input type="text" id="newApiKey" readonly>
          <button type="button" id="btnCopyKey">复制密钥</button>
        </div>
        <p class="helper-text">提示：复制后可在安全的密码管理器中保存。</p>
        <div class="code-card">
          <button type="button" class="copy-code" id="btnCopyCurl">复制命令</button>
          <pre><code>curl -H "Authorization: Bearer <span id="exampleKey"></span>" \
  https://your-domain.com/api/pages/create \
  -d '{"htmlContent": "&lt;h1&gt;Hello&lt;/h1&gt;"}'</code></pre>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn-secondary" id="btnCloseSuccessModalFooter">我已保存</button>
    </div>
  </div>
</div>
<script>
// API Key管理相关的JavaScript代码
let apiKeys = [];
let filteredKeys = [];
let searchKeyword = '';
let statusFilter = 'all';
let permissionFilter = 'all';

// 页面加载完成后初始化
document.addEventListener('DOMContentLoaded', function() {
  bindEventListeners();
  loadApiKeys();
  loadStatistics();
  if (typeof __initAfterBind === 'function') __initAfterBind();
});

// 加载API Key列表
async function loadApiKeys() {
  const spinner = document.getElementById('loadingSpinner');
  const container = document.getElementById('keyListContainer');
  if (spinner && container) {
    spinner.style.display = 'block';
    container.style.display = 'none';
  }
  try {
    const response = await fetch('/api/admin/apikeys');
    const data = await response.json();
    
    if (data.success) {
      apiKeys = Array.isArray(data.keys) ? data.keys : [];
      applyFilters();
    } else {
      showNotification('加载API Key列表失败: ' + data.error, 'error');
    }
  } catch (error) {
    console.error('加载API Key列表错误:', error);
    showNotification('加载API Key列表失败', 'error');
  } finally {
    if (spinner) spinner.style.display = 'none';
    if (container) container.style.display = 'block';
  }
}

function applyFilters() {
  const keyword = searchKeyword.trim().toLowerCase();
  filteredKeys = apiKeys.filter((key) => {
    const permissions = (key.permissions || '').split(',').map(p => p.trim());
    const matchSearch = !keyword || [key.name, key.description, key.key_id]
      .some(text => (text || '').toLowerCase().includes(keyword));

    const isActive = key.is_active === 1 || key.is_active === true;
    const matchStatus = statusFilter === 'all'
      ? true
      : statusFilter === 'active'
        ? isActive
        : !isActive;

    const hasWrite = permissions.includes('write');
    const matchPermission = permissionFilter === 'all'
      ? true
      : permissionFilter === 'write'
        ? hasWrite
        : !hasWrite;

    return matchSearch && matchStatus && matchPermission;
  });

  renderKeyList();
}

// 渲染API Key列表
function renderKeyList() {
  const tbody = document.getElementById('keyListBody');
  const emptyState = document.getElementById('emptyState');
  const emptyTitle = emptyState ? emptyState.querySelector('.empty-title') : null;
  const emptyDesc = emptyState ? emptyState.querySelector('.empty-desc') : null;
  const emptyAction = emptyState ? emptyState.querySelector('button') : null;
  
  if (!filteredKeys.length) {
    tbody.innerHTML = '';
    if (emptyTitle && emptyDesc) {
      if (apiKeys.length === 0) {
        emptyTitle.textContent = '还没有 API Key';
        emptyDesc.textContent = '立即创建您的第一个 API Key，并安全地控管访问权限。';
        if (emptyAction) {
          emptyAction.dataset.action = 'create';
          emptyAction.innerHTML = '<i class="fas fa-plus"></i> 创建新Key';
        }
      } else {
        emptyTitle.textContent = '没有匹配的 API Key';
        emptyDesc.textContent = '请调整搜索或筛选条件，或创建新的 API Key。';
        if (emptyAction) {
          emptyAction.dataset.action = 'reset';
          emptyAction.innerHTML = '<i class="fas fa-sync"></i> 清除筛选';
        }
      }
    }
    emptyState.style.display = 'block';
    return;
  }
  
  emptyState.style.display = 'none';
  if (emptyAction) {
    emptyAction.dataset.action = 'create';
    emptyAction.innerHTML = '<i class="fas fa-plus"></i> 创建新Key';
  }
  
  tbody.innerHTML = filteredKeys.map(key => {
    const permissions = (key.permissions || '').split(',').map(p => p.trim()).filter(Boolean);
    const hourlyLimit = key.max_requests_per_hour ? `${key.max_requests_per_hour}/h` : '—/h';
    const dailyLimit = key.max_requests_per_day ? `${key.max_requests_per_day}/d` : '—/d';
    const limitText = `${hourlyLimit} · ${dailyLimit}`;
    const isActive = key.is_active === 1 || key.is_active === true;
    const isExpired = key.expires_at && key.expires_at < Date.now();
    const lastUsed = key.last_used_at ? formatDate(key.last_used_at) : '从未使用';
    const createdAt = formatDate(key.created_at);

    return `
      <tr>
        <td data-label="名称">
          <div class="key-info">
            <span class="key-name">${escapeHtml(key.name || '未命名 Key')}</span>
            ${key.description ? `<span class="key-desc">${escapeHtml(key.description)}</span>` : ''}
          </div>
        </td>
        <td data-label="权限">
          <div class="chip-row">
            ${permissions.map(p => `<span class="chip ${p === 'write' ? 'write' : 'read'}">${p}</span>`).join('')}
          </div>
        </td>
        <td data-label="使用限制">
          <span class="limit-text">${limitText}</span>
        </td>
        <td data-label="状态">
          <div class="status-stack">
            <span class="pill ${isActive ? 'active' : 'disabled'}">${isActive ? '活跃' : '已禁用'}</span>
            ${isExpired ? '<span class="helper-text">已过期</span>' : ''}
          </div>
        </td>
        <td data-label="最后使用">${lastUsed}</td>
        <td data-label="创建时间">${createdAt}</td>
        <td data-label="操作" class="actions-cell">
          <div class="actions-group">
            <button class="table-action view" data-action="view" data-key-id="${key.key_id}" title="查看详情" aria-label="查看详情">
              <i class="fas fa-eye"></i>
            </button>
            <button class="table-action toggle" data-action="toggle" data-key-id="${key.key_id}" data-next-active="${!isActive}" title="${isActive ? '禁用 Key' : '启用 Key'}" aria-label="${isActive ? '禁用 Key' : '启用 Key'}">
              <i class="fas ${isActive ? 'fa-pause' : 'fa-play'}"></i>
            </button>
            <button class="table-action danger" data-action="delete" data-key-id="${key.key_id}" data-key-name="${escapeHtml(key.name || '')}" title="删除" aria-label="删除">
              <i class="fas fa-trash"></i>
            </button>
          </div>
        </td>
      </tr>
    `;
  }).join('');
}

// 加载统计信息
async function loadStatistics() {
  try {
    const response = await fetch('/api/admin/apikeys/stats');
    const data = await response.json();
    
    if (data.success) {
      const stats = data.stats || {};
      const elTotal = document.getElementById('totalKeys');
      const elActive = document.getElementById('activeKeys');
      const elToday = document.getElementById('todayCalls');
      const elAvg = document.getElementById('avgResponseTime');
      const valueOrDash = (value) => (value === null || value === undefined) ? '—' : value;
      const valueWithUnit = (value, unit) => {
        const numeric = valueOrDash(value);
        return numeric === '—' ? '—' : `${numeric}${unit}`;
      };
      if (elTotal) elTotal.textContent = valueOrDash(stats.totalKeys);
      if (elActive) elActive.textContent = valueOrDash(stats.activeKeys);
      if (elToday) elToday.textContent = valueOrDash(stats.todayCalls);
      if (elAvg) elAvg.textContent = valueWithUnit(stats.avgResponseTime, 'ms');
    }
  } catch (error) {
    console.error('加载统计信息错误:', error);
  }
}

/**
 * 绑定页面事件（替代内联事件，满足CSP）
 * - 解决内联事件因 Helmet 的 `script-src-attr 'none'` 被拦截的问题
 * - 统一绑定静态按钮及表格内的动态操作（查看/启用/禁用/删除）
 */
function bindEventListeners() {
  const byId = (id) => document.getElementById(id);

  const bind = (id, event, handler) => {
    const el = byId(id);
    if (el) el.addEventListener(event, handler);
  };

  bind('btnOpenCreateKey', 'click', () => showCreateModal());
  bind('btnCloseCreateModal', 'click', () => hideCreateModal());
  bind('btnCancelCreateModal', 'click', () => hideCreateModal());
  bind('createKeyBtn', 'click', () => createApiKey());
  bind('btnCopyKey', 'click', () => copyApiKey());
  bind('btnCloseSuccessModal', 'click', () => hideKeySuccessModal());
  bind('btnCloseSuccessModalFooter', 'click', () => hideKeySuccessModal());
  bind('btnCopyCurl', 'click', () => copyCurlCommand());
  bind('btnCloseKeyDetail', 'click', () => hideKeyDetailModal());
  bind('btnCloseKeyDetail2', 'click', () => hideKeyDetailModal());
  bind('btnRefreshKeys', 'click', () => refreshKeyList());

  const searchInput = byId('apiKeySearchInput');
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchKeyword = e.target.value || '';
      toggleSearchClear();
      applyFilters();
    });

    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        searchKeyword = '';
        searchInput.value = '';
        toggleSearchClear();
        applyFilters();
      }
    });
  }

  const searchClear = byId('apiKeySearchClear');
  if (searchClear) {
    searchClear.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchKeyword = '';
      toggleSearchClear();
      applyFilters();
      if (searchInput) searchInput.focus();
    });
  }

  document.querySelectorAll('[data-filter-status]').forEach(chip => {
    chip.addEventListener('click', () => {
      statusFilter = chip.getAttribute('data-filter-status') || 'all';
      updateChipGroup('[data-filter-status]', 'data-filter-status', statusFilter);
      applyFilters();
    });
  });

  document.querySelectorAll('[data-filter-permission]').forEach(chip => {
    chip.addEventListener('click', () => {
      permissionFilter = chip.getAttribute('data-filter-permission') || 'all';
      updateChipGroup('[data-filter-permission]', 'data-filter-permission', permissionFilter);
      applyFilters();
    });
  });

  const tbody = byId('keyListBody');
  if (tbody) {
    tbody.addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-action]');
      if (!btn) return;
      const action = btn.getAttribute('data-action');
      const keyId = btn.getAttribute('data-key-id');
      if (!keyId) return;
      if (action === 'view') {
        showKeyDetail(keyId);
      } else if (action === 'toggle') {
        const next = btn.getAttribute('data-next-active') === 'true';
        toggleKey(keyId, next);
      } else if (action === 'delete') {
        deleteKey(keyId);
      }
    });
  }

  toggleSearchClear();
  updateChipGroup('[data-filter-status]', 'data-filter-status', statusFilter);
  updateChipGroup('[data-filter-permission]', 'data-filter-permission', permissionFilter);

  const emptyButton = byId('btnOpenCreateKeyEmpty');
  if (emptyButton) {
    emptyButton.addEventListener('click', () => {
      if (emptyButton.dataset.action === 'reset') {
        resetFilters();
      } else {
        showCreateModal();
      }
    });
  }
}

function toggleSearchClear() {
  const clear = document.getElementById('apiKeySearchClear');
  const input = document.getElementById('apiKeySearchInput');
  if (!clear || !input) return;
  clear.style.display = input.value && input.value.trim() ? 'block' : 'none';
}

function updateChipGroup(selector, attr, activeValue) {
  document.querySelectorAll(selector).forEach(chip => {
    const value = chip.getAttribute(attr);
    if (value === activeValue) {
      chip.classList.add('is-active');
    } else {
      chip.classList.remove('is-active');
    }
  });
}

function resetFilters() {
  searchKeyword = '';
  statusFilter = 'all';
  permissionFilter = 'all';

  const searchInput = document.getElementById('apiKeySearchInput');
  if (searchInput) {
    searchInput.value = '';
  }

  toggleSearchClear();
  updateChipGroup('[data-filter-status]', 'data-filter-status', statusFilter);
  updateChipGroup('[data-filter-permission]', 'data-filter-permission', permissionFilter);
  applyFilters();
  if (searchInput) searchInput.focus();
}

// 页面加载完成后初始化增强功能
// 初始表单增强能力由 bindEventListeners 之后调用
// 注意：bindEventListeners 在 DOMContentLoaded 中先行执行
/**
 * 在事件绑定完成后初始化表单增强与校验
 * 目的：解耦 DOMContentLoaded 中的顺序与依赖
 */
function __initAfterBind() {
  initFormValidation();
  initFormEnhancements();
}

// 初始化表单验证
function initFormValidation() {
  const nameInput = document.getElementById('keyName');
  const maxHourlyInput = document.getElementById('maxHourly');
  const maxDailyInput = document.getElementById('maxDaily');
  
  // 名称实时验证
  nameInput.addEventListener('input', function() {
    validateKeyName(this.value);
  });
  
  // 限制数值验证
  maxHourlyInput.addEventListener('input', function() {
    validateLimit(this, 'maxHourlyFeedback', 1, 10000);
  });
  
  maxDailyInput.addEventListener('input', function() {
    validateLimit(this, 'maxDailyFeedback', 1, 100000);
    validateDailyVsHourly();
  });
}

// 初始化表单增强功能
function initFormEnhancements() {
  // 权限卡片点击切换
  document.querySelectorAll('.permission-card').forEach(card => {
    card.addEventListener('click', function(e) {
      const checkbox = this.querySelector('input[type="checkbox"]');
      if (!checkbox) return;
      checkbox.checked = !checkbox.checked;
      checkbox.dispatchEvent(new Event('change'));
    });
  });
  
  // 权限切换动画
  document.querySelectorAll('input[name="permissions"]').forEach(input => {
    const card = input.closest('.permission-card');
    if (card) {
      updatePermissionCardState(card, input.checked);
    }
    input.addEventListener('change', function() {
      const nextCard = this.closest('.permission-card');
      if (!nextCard) return;
      updatePermissionCardState(nextCard, this.checked);
    });
  });
}

function updatePermissionCardState(card, isActive) {
  const toggle = card.querySelector('.toggle-switch');
  if (isActive) {
    card.classList.add('is-active');
    card.classList.add('permission-active');
    if (toggle) toggle.classList.add('is-on');
  } else {
    card.classList.remove('is-active');
    card.classList.remove('permission-active');
    if (toggle) toggle.classList.remove('is-on');
  }
}

// 验证API Key名称
function validateKeyName(name) {
  const feedback = document.getElementById('keyNameFeedback');
  
  if (!name.trim()) {
    showFieldFeedback(feedback, '', '');
    return false;
  }
  
  if (name.length < 3) {
    showFieldFeedback(feedback, '名称至少需要3个字符', 'error');
    return false;
  }
  
  if (name.length > 50) {
    showFieldFeedback(feedback, '名称不能超过50个字符', 'error');
    return false;
  }
  
  showFieldFeedback(feedback, '名称格式正确', 'success');
  return true;
}

// 验证限制数值
function validateLimit(input, feedbackId, min, max) {
  const feedback = document.getElementById(feedbackId);
  const value = parseInt(input.value);
  
  if (isNaN(value) || value < min) {
    showFieldFeedback(feedback, `最小值为 ${min}`, 'error');
    return false;
  }
  
  if (value > max) {
    showFieldFeedback(feedback, `最大值为 ${max}`, 'error');
    return false;
  }
  
  showFieldFeedback(feedback, '数值有效', 'success');
  return true;
}

// 验证每日限制是否大于每小时限制
function validateDailyVsHourly() {
  const hourly = parseInt(document.getElementById('maxHourly').value);
  const daily = parseInt(document.getElementById('maxDaily').value);
  const feedback = document.getElementById('maxDailyFeedback');
  
  if (!isNaN(hourly) && !isNaN(daily) && daily < hourly) {
    showFieldFeedback(feedback, '每日限制应大于每小时限制', 'error');
    return false;
  }
  
  return true;
}

// 显示字段反馈
function showFieldFeedback(element, message, type) {
  element.textContent = message;
  element.className = `form-feedback ${type}`;
}

// 创建API Key - 增强版本
async function createApiKey() {
  const form = document.getElementById('createKeyForm');
  const formData = new FormData(form);
  const createBtn = document.getElementById('createKeyBtn');
  
  // 表单验证
  const nameValid = validateKeyName(formData.get('name'));
  const hourlyValid = validateLimit(document.getElementById('maxHourly'), 'maxHourlyFeedback', 1, 10000);
  const dailyValid = validateLimit(document.getElementById('maxDaily'), 'maxDailyFeedback', 1, 100000);
  const dailyVsHourlyValid = validateDailyVsHourly();
  
  if (!nameValid || !hourlyValid || !dailyValid || !dailyVsHourlyValid) {
    showNotification('请修正表单中的错误', 'error');
    return;
  }
  
  // 收集权限
  const permissions = Array.from(form.querySelectorAll('input[name="permissions"]:checked'))
    .map(input => input.value);
  
  if (permissions.length === 0) {
    showNotification('请至少选择一个权限', 'warning');
    return;
  }
  
  // 显示加载状态
  showButtonLoading(createBtn, true);
  
  const keyData = {
    name: formData.get('name'),
    description: formData.get('description'),
    permissions: permissions,
    maxRequestsPerHour: parseInt(formData.get('maxRequestsPerHour')),
    maxRequestsPerDay: parseInt(formData.get('maxRequestsPerDay')),
    expiresAt: formData.get('expiresAt') ? new Date(formData.get('expiresAt')).getTime() : null
  };
  
  try {
    const response = await fetch('/api/admin/apikeys', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(keyData)
    });
    
    const data = await response.json();
    
    if (data.success) {
      hideCreateModal();
      showKeySuccess(data.apiKey);
      loadApiKeys();
      loadStatistics();
      showNotification('API Key创建成功', 'success');
    } else {
      showNotification('创建API Key失败: ' + data.error, 'error');
    }
  } catch (error) {
    console.error('创建API Key错误:', error);
    showNotification('创建API Key失败', 'error');
  } finally {
    showButtonLoading(createBtn, false);
  }
}

// 按钮加载状态控制
function showButtonLoading(button, isLoading) {
  const content = button.querySelector('.btn-content');
  const loading = button.querySelector('.btn-loading');
  
  if (isLoading) {
    content.style.display = 'none';
    loading.style.display = 'flex';
    button.disabled = true;
  } else {
    content.style.display = 'flex';
    loading.style.display = 'none';
    button.disabled = false;
  }
}

// 显示创建模态框 - 增强版本
function showCreateModal() {
  const modal = document.getElementById('createModal');
  const form = document.getElementById('createKeyForm');
  
  // 重置表单
  form.reset();
  
  // 清除所有反馈
  document.querySelectorAll('.form-feedback').forEach(feedback => {
    feedback.textContent = '';
    feedback.className = 'form-feedback';
  });
  
  // 重置权限卡片状态
  document.querySelectorAll('.permission-card').forEach(card => {
    const checkbox = card.querySelector('input[type="checkbox"]');
    if (!checkbox) return;
    checkbox.checked = checkbox.defaultChecked;
    updatePermissionCardState(card, checkbox.defaultChecked);
  });
  
  // 显示模态框
  modal.style.display = 'flex';
  
  // 聚焦到名称输入框
  setTimeout(() => {
    document.getElementById('keyName').focus();
  }, 300);
}

// 隐藏创建模态框 - 增强版本
function hideCreateModal() {
  const modal = document.getElementById('createModal');
  modal.style.display = 'none';
  const form = document.getElementById('createKeyForm');
  if (form) form.reset();
  document.querySelectorAll('.permission-card').forEach(card => {
    const checkbox = card.querySelector('input[type="checkbox"]');
    if (!checkbox) return;
    checkbox.checked = checkbox.defaultChecked;
    updatePermissionCardState(card, checkbox.defaultChecked);
  });
  
  // 重置按钮状态
  const createBtn = document.getElementById('createKeyBtn');
  showButtonLoading(createBtn, false);
}

// 显示API Key创建成功模态框
function showKeySuccess(apiKey) {
  const keyInput = document.getElementById('newApiKey');
  const curlKey = document.getElementById('exampleKey');
  const modal = document.getElementById('keySuccessModal');
  if (!keyInput || !curlKey || !modal) return;
  keyInput.value = apiKey;
  curlKey.textContent = apiKey;
  modal.dataset.apiKey = apiKey;
  modal.style.display = 'flex';
}

// 隐藏API Key成功模态框
function hideKeySuccessModal() {
  const modal = document.getElementById('keySuccessModal');
  if (modal) {
    modal.style.display = 'none';
    modal.dataset.apiKey = '';
  }
}

// 复制API Key
function copyApiKey() {
  const input = document.getElementById('newApiKey');
  if (!input) return;
  copyToClipboard(input.value, 'API Key 已复制到剪贴板');
}

function copyCurlCommand() {
  const modal = document.getElementById('keySuccessModal');
  let apiKey = '';
  if (modal && modal.dataset && modal.dataset.apiKey) {
    apiKey = modal.dataset.apiKey;
  } else {
    const keyInput = document.getElementById('newApiKey');
    if (keyInput) {
      apiKey = keyInput.value;
    }
  }
  if (!apiKey) {
    showNotification('未找到 API Key，请先创建。', 'warning');
    return;
  }
  const command = `curl -H "Authorization: Bearer ${apiKey}" \
  https://your-domain.com/api/pages/create \
  -d '{"htmlContent": "<h1>Hello</h1>"}'`;
  copyToClipboard(command, '示例命令已复制');
}

async function copyToClipboard(text, successMessage) {
  try {
    if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
      await navigator.clipboard.writeText(text);
    } else {
      const helper = document.createElement('textarea');
      helper.value = text;
      helper.setAttribute('readonly', 'readonly');
      helper.style.position = 'fixed';
      helper.style.opacity = '0';
      document.body.appendChild(helper);
      helper.select();
      try {
        document.execCommand('copy');
      } finally {
        document.body.removeChild(helper);
      }
    }
    if (successMessage) {
      showNotification(successMessage, 'success');
    }
  } catch (error) {
    console.error('复制内容失败:', error);
    showNotification('复制失败，请手动复制。', 'error');
  }
}

// 刷新Key列表
function refreshKeyList() {
  document.getElementById('loadingSpinner').style.display = 'block';
  document.getElementById('keyListContainer').style.display = 'none';
  loadApiKeys();
  loadStatistics();
}

// 显示Key详情
async function showKeyDetail(keyId) {
  try {
    const response = await fetch(`/api/admin/apikeys/${keyId}/stats`);
    const data = await response.json();

    if (data.success) {
      const key = apiKeys.find(k => k.key_id === keyId);
      if (!key) {
        showNotification('未找到 API Key 详情', 'warning');
        return;
      }

      const stats = data.stats || {};
      const isActive = key.is_active === 1 || key.is_active === true;
      const permissions = (key.permissions || '').split(',').map(p => p.trim()).filter(Boolean);
      const permissionChips = permissions.length
        ? permissions.map(p => `<span class="chip ${p === 'write' ? 'write' : 'read'}">${escapeHtml(p)}</span>`).join('')
        : '<span class="helper-text">未配置权限</span>';
      const statusPill = `<span class="pill ${isActive ? 'active' : 'disabled'}">${isActive ? '活跃' : '已禁用'}</span>`;

      const name = escapeHtml(key.name || '未命名 Key');
      const description = escapeHtml(key.description || '暂无描述');
      const keyIdHtml = escapeHtml(key.key_id);
      const createdAt = formatDate(key.created_at);
      const lastUsedAt = key.last_used_at ? formatDate(key.last_used_at) : '从未使用';
      const expiresAt = key.expires_at ? formatDate(key.expires_at) : '永不过期';
      const hourlyLimit = key.max_requests_per_hour ? `${key.max_requests_per_hour} 次` : '未设置';
      const dailyLimit = key.max_requests_per_day ? `${key.max_requests_per_day} 次` : '未设置';

      const totalCalls = stats.totalCalls ?? 0;
      const successCalls = stats.successCalls ?? 0;
      const rawErrorCalls = stats.errorCalls ?? (totalCalls - successCalls);
      const errorCalls = rawErrorCalls < 0 ? 0 : rawErrorCalls;
      const avgResponse = Math.round(stats.avgResponseTime ?? 0);
      const topEndpoints = Array.isArray(stats.topEndpoints) ? stats.topEndpoints : [];

      const metricsHtml = [
        { label: '总调用次数', value: totalCalls },
        { label: '成功调用', value: successCalls },
        { label: '失败调用', value: errorCalls },
        { label: '平均响应时间', value: `${avgResponse} ms` }
      ].map(metric => `
        <div class="metric-card">
          <span class="metric-value">${escapeHtml(String(metric.value))}</span>
          <span class="metric-label">${metric.label}</span>
        </div>
      `).join('');

      const endpointsHtml = topEndpoints.length ? `
        <div class="detail-section">
          <h4 class="section-title">热门端点</h4>
          <div class="endpoint-list">
            ${topEndpoints.map(ep => `
              <div class="endpoint-item">
                <span class="endpoint-path">${escapeHtml(ep.endpoint || '')}</span>
                <span class="endpoint-count">${ep.count ?? 0} 次</span>
              </div>
            `).join('')}
          </div>
        </div>
      ` : '';

      const detailContent = `
        <div class="detail-card">
          <div class="detail-header">
            <div>
              <h3 class="detail-title">${name}</h3>
              <p class="detail-subtitle">${description}</p>
            </div>
            <div class="detail-header-meta">
              ${statusPill}
              <span class="code-chip">ID: ${keyIdHtml}</span>
            </div>
          </div>

          <div class="detail-section">
            <h4 class="section-title">基本信息</h4>
            <div class="detail-grid">
              <div class="kv-item">
                <span class="kv-label">权限</span>
                <span class="kv-value kv-chips">${permissionChips}</span>
              </div>
              <div class="kv-item">
                <span class="kv-label">状态</span>
                <span class="kv-value">${statusPill}</span>
              </div>
              <div class="kv-item">
                <span class="kv-label">创建时间</span>
                <span class="kv-value">${createdAt}</span>
              </div>
              <div class="kv-item">
                <span class="kv-label">最后使用</span>
                <span class="kv-value">${lastUsedAt}</span>
              </div>
            </div>
          </div>

          <div class="detail-section">
            <h4 class="section-title">使用限制</h4>
            <div class="detail-grid">
              <div class="kv-item">
                <span class="kv-label">每小时限制</span>
                <span class="kv-value">${hourlyLimit}</span>
              </div>
              <div class="kv-item">
                <span class="kv-label">每日限制</span>
                <span class="kv-value">${dailyLimit}</span>
              </div>
              <div class="kv-item">
                <span class="kv-label">过期时间</span>
                <span class="kv-value">${expiresAt}</span>
              </div>
            </div>
          </div>

          <div class="detail-section">
            <h4 class="section-title">使用统计（最近7天）</h4>
            <div class="metric-grid">
              ${metricsHtml}
            </div>
          </div>

          ${endpointsHtml}
        </div>
      `;

      document.getElementById('keyDetailContent').innerHTML = detailContent;
      document.getElementById('keyDetailModal').style.display = 'flex';
    } else {
      showNotification('获取Key详情失败: ' + data.error, 'error');
    }
  } catch (error) {
    console.error('获取Key详情错误:', error);
    showNotification('获取Key详情失败', 'error');
  }
}
// 隐藏Key详情模态框
function hideKeyDetailModal() {
  document.getElementById('keyDetailModal').style.display = 'none';
}

// 切换Key状态
async function toggleKey(keyId, isActive) {
  try {
    const response = await fetch(`/api/admin/apikeys/${keyId}`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ isActive })
    });
    
    const data = await response.json();
    
    if (data.success) {
      showNotification(`API Key已${isActive ? '启用' : '禁用'}`, 'success');
      loadApiKeys();
      loadStatistics();
    } else {
      showNotification('操作失败: ' + data.error, 'error');
    }
  } catch (error) {
    console.error('切换Key状态错误:', error);
    showNotification('操作失败', 'error');
  }
}

// 删除Key
async function deleteKey(keyId) {
  const key = apiKeys.find(k => k.key_id === keyId);
  
  if (!confirm(`确定要删除API Key "${key.name}" 吗？此操作无法撤销。`)) {
    return;
  }
  
  try {
    const response = await fetch(`/api/admin/apikeys/${keyId}`, {
      method: 'DELETE'
    });
    
    const data = await response.json();
    
    if (data.success) {
      showNotification('API Key已删除', 'success');
      loadApiKeys();
      loadStatistics();
    } else {
      showNotification('删除失败: ' + data.error, 'error');
    }
  } catch (error) {
    console.error('删除Key错误:', error);
    showNotification('删除失败', 'error');
  }
}

// 工具函数
function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

function formatDate(timestamp) {
  if (timestamp === null || timestamp === undefined || timestamp === '') {
    return '—';
  }
  const numeric = Number(timestamp);
  if (!Number.isFinite(numeric)) {
    return '—';
  }
  const date = new Date(numeric);
  if (Number.isNaN(date.getTime())) {
    return '—';
  }
  return date.toLocaleString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit'
  });
}
