# docker-compose.override.yml.example
# 复制此文件为 docker-compose.override.yml 用于开发环境

version: '3.8'

services:
  html-go:
    build:
      target: builder  # 使用构建阶段，包含开发依赖
    environment:
      - NODE_ENV=development
      - DEBUG=html-go:*
    volumes:
      - .:/usr/src/app  # 挂载整个项目目录用于热重载
      - /usr/src/app/node_modules  # 避免覆盖容器内的 node_modules
      - /usr/src/app/db  # 避免覆盖开发数据库
    command: npm run dev  # 使用开发模式启动
    ports:
      - "9229:9229"  # Node.js 调试端口